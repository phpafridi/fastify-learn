{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",  // Add this
    "strict": true,
    "verbatimModuleSyntax": false,    // Change to false
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true         // Add this
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}